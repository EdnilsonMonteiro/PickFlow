   "title": "Prompt (transferir objeto)",
   "properties": {
    "Node name for S&R": "TextEncodeQwenImage21"
   },
   "widgets_values": [
    "Transfer several objects into <image1>. Each numbered green box in <image1> marks where one object goes and how big it is. Green box 1: the object inside the red box in <image2>. Green box 2: the object inside the red box in <image3>. Match perspective, scale, lighting, shadows, color and style of <image1>. Preserve everything else in <image1> exactly. Remove every box, number and border.",
    "bounding boxes, rectangle, colored frame, seam, blurry, low quality, deformed, extra objects, watermark, text",
    0
   ],
   "widgets_values_named": {
    "prompt": "Transfer the object (or body part) inside the red box in <image2> into <image1>, placing it at the position and size indicated by the green box in <image1>. Match the perspective, scale, orientation, lighting, shadows, color and overall style of <image1> so the transferred element blends in naturally, as if it were originally part of <image1>. Preserve everything else in <image1> exactly (background, other objects, identity). Remove the red and green boxes and any borders.",
    "negative_prompt": "bounding boxes, rectangle, colored frame, seam, blurry, low quality, deformed, extra objects, watermark, text",
    "resolution": 0
   }
  },
