# Copy this file to .env (in the same folder) and fill it in. The .env never goes into git.
#
# Hugging Face token: only needed to download restricted LoRAs or ones that require accepting a license.
# Create one at https://huggingface.co/settings/tokens (read permission) and restart PickFlow.
HF_TOKEN=

# API keys of the prompt writer's LLMs (Settings > Writer and agent). Each provider uses a variable
# LLM_API_KEY_<provider id>; the PickFlow screen also writes here ("Save key" button). A local server needs no key.
# LLM_API_KEY_OPENAI=
# LLM_API_KEY_OPENROUTER=
# LLM_API_KEY_GEMINI=
# LLM_API_KEY_ANTHROPIC=
