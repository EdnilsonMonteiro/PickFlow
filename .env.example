# Copie este arquivo para .env (na mesma pasta) e preencha. O .env nunca vai para o git.
#
# Token do Hugging Face: só é preciso para baixar LoRAs restritas ou que exigem aceitar uma licença.
# Crie em https://huggingface.co/settings/tokens (permissão de leitura) e reinicie o PickFlow.
HF_TOKEN=

# Chaves de API dos LLMs do redator de prompt (Ajustes > Redator de prompt). Cada provedor usa uma variável
# LLM_API_KEY_<ID do provedor>; a tela do PickFlow também grava aqui (botão "Guardar chave"). Servidor local não precisa.
# LLM_API_KEY_OPENAI=
# LLM_API_KEY_OPENROUTER=
# LLM_API_KEY_GEMINI=
# LLM_API_KEY_ANTHROPIC=
